+def _managed_media_roots() -> List[Path]:
+    """Return the host media roots Hermes itself manages for attachments."""
+    from hermes_constants import get_hermes_home
+
+    home = get_hermes_home()
+    return [
+        home / "cache",
+        home / "images",
+        home / "image_cache",
+        home / "audio_cache",
+        home / "video_cache",
+        home / "temp_vision_images",
+        home / "temp_video_files",
+    ]
+
+
+def _detected_image_mime(data: bytes) -> Optional[str]:
+    """Identify the small set of image formats accepted by MiniMax inputs."""
+    if data.startswith(b"\x89PNG\r\n\x1a\n"):
+        return "image/png"
+    if data.startswith(b"\xff\xd8\xff"):
+        return "image/jpeg"
+    if data.startswith((b"GIF87a", b"GIF89a")):
+        return "image/gif"
+    if len(data) >= 12 and data.startswith(b"RIFF") and data[8:12] == b"WEBP":
+        return "image/webp"
+    return None
+
+
