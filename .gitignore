# NixOS flake config — per ryan4yin/nixos-and-flakes-book
# flake.lock is generated by `nix flake update`; keep it committed so
# the system is reproducible across machines.
result
result-*
*.qcow2
*.vdi

# Local backups of auto-generated files (kept on disk, not in git)
*.bak-old

# Game logs / launcher configs (not NixOS config)
logs/
launchersettings.json

# Editor / OS cruft
.DS_Store
*.swp
*~

# Python bytecode caches (generated by running regression tests)
__pycache__/
*.pyc

# Agent worktrees (branches checked out for parallel work)
.worktrees/

# graphify-out — AST-derived knowledge graph. Regenerated by `graphify update .`
# (per AGENTS.md) after any code change. Treat as a build artifact, not source:
# cluttering PR diffs with thousands of regenerated graph.json lines has no
# review value. Each host regenerates locally on demand.
graphify-out/